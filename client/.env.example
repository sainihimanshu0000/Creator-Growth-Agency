# Admin login password (change in production)
ADMIN_PASSWORD=vantage-admin

# Optional separate signing secret for admin session cookies
ADMIN_SECRET=change-me-in-production

# MongoDB connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.ryplaoz.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Resend: email alert for each new inquiry (comma-separate multiple NOTIFY_EMAIL)
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional, needs a verified domain in Resend. Defaults to onboarding@resend.dev
NOTIFY_FROM=
